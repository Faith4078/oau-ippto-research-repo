# Local development example. Never commit real secrets.

# App
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oau_ippto
DATABASE_URL_POOLER=postgresql://postgres:postgres@localhost:5432/oau_ippto
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oau_ippto_test

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# One-time super administrator bootstrap. Inject these from your deployment
# secret manager only while running `pnpm admin:bootstrap`, then remove them.
SUPER_ADMIN_STAFF_ID=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=

# Transactional email (provider HTTP endpoint accepting from/to/subject/text/html)
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_FROM=OAU IPTTO Repository <repository@oauife.edu.ng>
# Never exposes links in production, even when enabled.
PASSWORD_RESET_DEBUG=false

# Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=oau-ippto-research
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=
R2_SIGNED_UPLOAD_EXPIRES_SECONDS=300
R2_SIGNED_DOWNLOAD_EXPIRES_SECONDS=300
MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/png,image/jpeg

# Workers and queues
WORKER_BASE_URL=
WORKER_SIGNING_SECRET=replace-with-a-long-random-secret
JOB_QUEUE_NAME=oau-ippto-processing
JOB_RETRY_LIMIT=3
JOB_RETRY_DELAY_SECONDS=60

# Cache and revalidation
REVALIDATION_SECRET=replace-with-a-long-random-secret
CACHE_DEFAULT_SECONDS=300
CACHE_PUBLIC_STATS_SECONDS=900

# Rate limits
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SIGNED_UPLOAD_PER_MINUTE=30
RATE_LIMIT_SIGNED_DOWNLOAD_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=120
